# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — Environment Variables
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to git. Add it to .gitignore.
# All values here are placeholders — none are real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────

# Password for the 'jarvis' PostgreSQL user (used by docker-compose).
# The full DATABASE_URL is assembled by docker-compose from this value.
POSTGRES_PASSWORD=change_me_strong_password

# If you are connecting to an external PostgreSQL instance (not docker-compose),
# set DATABASE_URL directly and remove the POSTGRES_PASSWORD line above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Anthropic (AI backbone) ───────────────────────────────────────────────────

# Your Anthropic API key. Jarvis uses Claude (claude-sonnet-4-6) for all
# reasoning, coding, planning, and research via this key.
# Required — the server will crash on start without this.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-api03-placeholder-replace-with-real-key

# Base URL for the Anthropic API. Use the default unless you are routing
# through a proxy or a Replit-managed integration endpoint.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Web Search (optional) ─────────────────────────────────────────────────────

# Brave Search API key. When set, the /api/search endpoint performs live
# web searches. When unset, Jarvis falls back to Claude's training knowledge.
# Get a key at: https://brave.com/search/api/
SEARCH_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the API server (Express) listens on inside the container.
# docker-compose maps this to the host via the 'web' nginx proxy.
PORT=8080

# Node.js environment. Set to 'production' for deployments.
# The api-server dev script sets this to 'development' automatically.
NODE_ENV=production

# Pino log level. Options: trace | debug | info | warn | error | fatal
# Use 'warn' or 'error' in production to reduce log volume.
LOG_LEVEL=warn

# ── Security (REQUIRED in production) ────────────────────────────────────────
#
# These two variables are the primary access controls for the Jarvis API.
# Neither is required in development — leave them blank locally and the server
# behaves exactly as before (open CORS, no auth).
# In production both MUST be set before the server is exposed to the internet.

# API_KEY — bearer token required on every request except GET /api/healthz.
#
#   All API clients (the Jarvis frontend, curl, any integrations) must send:
#     Authorization: Bearer <API_KEY>
#
#   Generate a strong key with:
#     openssl rand -hex 32
#
#   The frontend reads this from its own environment and includes it
#   automatically on every fetch (see src/lib/api.ts in the jarvas package).
#
#   Leave blank in development — auth is disabled when API_KEY is unset.
#
API_KEY=

# ALLOWED_ORIGINS — comma-separated list of origins permitted to make
#   cross-origin requests from a browser (CORS allowlist).
#
#   Format:  https://jarvis.example.com,https://app.example.com
#   No trailing slashes. No wildcards. Exact origin match only.
#
#   When set:   only the listed origins can call the API from a browser.
#   When unset + NODE_ENV=production: all browser origins are blocked
#     (curl / server-to-server calls still work — they have no Origin header).
#   When unset + NODE_ENV=development: all origins are allowed (existing
#     dev behaviour, unchanged).
#
#   Typical values:
#     Single domain:   ALLOWED_ORIGINS=https://jarvis.example.com
#     With localhost:  ALLOWED_ORIGINS=https://jarvis.example.com,http://localhost:5173
#
ALLOWED_ORIGINS=

# ── Frontend (build-time only) ────────────────────────────────────────────────

# These are consumed by Vite at BUILD TIME — they are baked into the static
# bundle and not read at runtime. Changing them requires a rebuild.

# URL base path prefix. Use "/" for root, "/jarvis/" for a sub-path.
# Must match the nginx location block if serving under a sub-path.
BASE_PATH=/

# ── HTTP exposure ─────────────────────────────────────────────────────────────

# Host port that the nginx web container binds on (docker-compose only).
# Typically 80 for HTTP (TLS is terminated upstream by a reverse proxy).
HTTP_PORT=80
